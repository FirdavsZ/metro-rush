# ─── Metro Rush — Client env ───────────────────────────────────────────────
# Copy to .env.local for local development.

# Backend API base URL.
# Leave EMPTY for local dev (Vite proxy routes /api → localhost:5000 automatically).
# Set to your deployed backend URL for production.
VITE_API_URL=
# Example production value:
# VITE_API_URL=https://metro-rush-api.onrender.com
