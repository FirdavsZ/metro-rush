# ─── Metro Rush — Server env ───────────────────────────────────────────────
# Copy to .env for local development. Never commit .env to git.

PORT=5000
NODE_ENV=development

# Frontend origin for CORS. Add your Vercel URL in production.
CLIENT_URL=http://localhost:5173
# CLIENT_URL=https://metro-rush.vercel.app

# JWT secret — use a long random string in production (32+ chars).
JWT_SECRET=change_this_to_a_strong_random_secret_in_production

# PostgreSQL connection string.
# Local:    postgresql://postgres:password@localhost:5432/metro_rush
# Neon:     postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/metro_rush?sslmode=require
# Supabase: postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/metro_rush
